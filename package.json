{
  "name": "codex-router",
  "displayName": "Codex Router",
  "description": "Local, privacy-preserving routing for ChatGPT-authenticated Codex tasks.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": ["AI", "Chat"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codexRouter.newRoutedTask",
        "title": "New Routed Task",
        "category": "Codex Router"
      },
      {
        "command": "codexRouter.routeSelection",
        "title": "Send Selection to Codex Router",
        "category": "Codex Router"
      },
      {
        "command": "codexRouter.generateProxyCandidate",
        "title": "Generate ModelDeck Proxy Candidate for Selection",
        "category": "Codex Router"
      },
      {
        "command": "codexRouter.showDiagnostics",
        "title": "Show Diagnostics",
        "category": "Codex Router"
      },
      {
        "command": "codexRouter.cancelActiveTurn",
        "title": "Cancel Active Turn",
        "category": "Codex Router"
      },
      {
        "command": "codexRouter.exportOutcomes",
        "title": "Export Outcome Report",
        "category": "Codex Router"
      },
      {
        "command": "codexRouter.clearOutcomes",
        "title": "Clear Local Outcome Records",
        "category": "Codex Router"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codexRouter.routeSelection",
          "group": "codexRouter",
          "when": "editorHasSelection"
        },
        {
          "command": "codexRouter.generateProxyCandidate",
          "group": "codexRouter",
          "when": "editorHasSelection"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexRouter",
          "title": "Codex Router",
          "icon": "media/codex-router.svg"
        }
      ]
    },
    "views": {
      "codexRouter": [
        {
          "id": "codexRouter.sidebar",
          "name": "Codex Router",
          "type": "webview",
          "contextualTitle": "Route a Codex task"
        }
      ]
    },
    "configuration": {
      "title": "Codex Router",
      "properties": {
        "codexRouter.routing.provider": {
          "type": "string",
          "enum": ["deterministic", "modeldeck-experimental"],
          "enumDescriptions": [
            "Use the transparent deterministic routing baseline without contacting ModelDeck.",
            "Use an experimental loopback ModelDeck classifier with deterministic safety guardrails."
          ],
          "default": "deterministic",
          "description": "Routing policy. ModelDeck classification is experimental and explicitly opt-in."
        },
        "codexRouter.modelDeck.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8600/v1",
          "description": "Loopback OpenAI-compatible ModelDeck endpoint used for local routing."
        },
        "codexRouter.modelDeck.routerModel": {
          "type": "string",
          "default": "",
          "description": "Optional ModelDeck model ID used for routing. Leave empty to select the first ready local model."
        },
        "codexRouter.modelDeck.proxyModel": {
          "type": "string",
          "default": "codex-router-proxy-balanced",
          "description": "ModelDeck model ID used only for explicitly requested selected-code proxy candidates."
        },
        "codexRouter.modelDeck.proxyTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Maximum time to wait for an explicitly requested local proxy candidate."
        },
        "codexRouter.modelDeck.proxyMaxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 256,
          "maximum": 8192,
          "description": "Maximum output-token budget for an explicitly requested local proxy candidate."
        },
        "codexRouter.requestTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Maximum time to wait for a local routing-model response."
        },
        "codexRouter.diagnostics.logRawClassifierResponses": {
          "type": "boolean",
          "default": false,
          "description": "Debug only: write rejected local-classifier responses to the Codex Router output channel. Responses may contain sensitive task content."
        },
        "codexRouter.analytics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Store privacy-preserving, local routing outcome records for evaluation."
        }
      }
    }
  },
  "scripts": {
    "compile": "pwsh -NoProfile -File scripts/invoke.ps1 compile",
    "watch": "pwsh -NoProfile -File scripts/invoke.ps1 watch",
    "test": "pwsh -NoProfile -File scripts/invoke.ps1 test",
    "check:baseline": "pwsh -NoProfile -File scripts/invoke.ps1 check-baseline",
    "check": "pwsh -NoProfile -File scripts/invoke.ps1 check",
    "eval:baseline": "pwsh -NoProfile -File scripts/invoke.ps1 eval-baseline",
    "eval:baseline:sim": "pwsh -NoProfile -File scripts/invoke.ps1 eval-baseline-sim"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.134.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
